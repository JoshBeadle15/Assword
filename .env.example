# Shared password required to open the vault in the browser.
SITE_PASSWORD=change-me

# Random long string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Where the SQLite file lives. Point this at a mounted Railway volume
# (e.g. /data/passwords.db) so data survives redeploys.
DB_PATH=./data/passwords.db
